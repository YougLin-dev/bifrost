# CNB image coordinates
# 这里直接填写完整镜像地址，避免 registry / 路径 / tag 被重复拼接。
# 同名制品示例:
#   BIFROST_IMAGE=docker.cnb.cool/fastrouter/bifrost:latest
# 非同名制品示例:
#   BIFROST_IMAGE=docker.cnb.cool/fastrouter/bifrost/bifrost-enterprise:latest
BIFROST_IMAGE=docker.cnb.cool/fastrouter/bifrost:latest

# Bifrost runtime
APP_HOST=0.0.0.0
APP_PORT=8080
LOG_LEVEL=info
LOG_STYLE=json
GOGC=200
GOMEMLIMIT=3600MiB

# PostgreSQL backend shared by config_store and logs_store
BIFROST_DB_HOST=postgres
BIFROST_DB_PORT=5432
BIFROST_DB_SSLMODE=disable
POSTGRES_USER=bifrost
POSTGRES_PASSWORD=change-this-postgres-password
POSTGRES_DB=bifrost

# Bifrost admin access
BIFROST_ADMIN_USERNAME=admin
BIFROST_ADMIN_PASSWORD=change-this-admin-password

# Used to encrypt sensitive values stored in Postgres.
BIFROST_ENCRYPTION_KEY=change-this-encryption-passphrase
